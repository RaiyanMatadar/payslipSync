# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# If left blank/unset, the backend automatically spins up an in-memory MongoDB instance
# For persistent local data:
# MONGO_URI=mongodb://127.0.0.1:27017/payroll
# For MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/payroll?retryWrites=true&w=majority

# Authentication Secret
JWT_SECRET=super_secret_payroll_jwt_key_2026_change_in_production

# Sensitive Fields Encryption Key (AES-256 for PAN, PF, UAN, Bank Details)
ENCRYPTION_KEY=default_super_secret_key_32_bytes_payroll

# Cloudinary Storage Configuration (Optional - falls back to Base64 data URI if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=